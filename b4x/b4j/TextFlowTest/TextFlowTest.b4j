AppType=JavaFX
Build1=Default,b4j.example
File1=balloonmask.png
File2=Layout1.bjl
FileGroup1=Default Group
FileGroup2=Default Group
Group=Default Group
Library1=javaobject
Library2=jcore
Library3=jfx
Library4=jxui
Library5=cssutils
Module1=BalloonText
Module2=DiamondText
Module3=TextFlow
NumberOfFiles=2
NumberOfLibraries=5
NumberOfModules=3
Version=10
@EndOfDesignText@
#Region Project Attributes 
	#MainFormWidth: 600
	#MainFormHeight: 600 
	'#JavaCompilerPath: 26, C:\Root\jdk-26.0.1-full\bin\
	'#VirtualMachineArgs: --add-opens javafx.graphics/com.sun.javafx.text=ALL-UNNAMED
#End Region

Sub Process_Globals
	Private fx As JFX
	Private MainForm As Form
	Private xui As XUI 
	Private Button1 As B4XView
	Private tf As TextFlow
End Sub

Sub AppStart (Form1 As Form, Args() As String)
	MainForm = Form1
	MainForm.RootPane.LoadLayout("Layout1")
	MainForm.RootPane.Style = "-fx-background-color: white;"
	MainForm.Show
	Button1.Visible = False

	'18_094.jpg：左边第一个气泡（x<180）左对齐，右边气泡（x>200）右对齐
	Dim maskL,maskR As Map
	Try
		maskL = BalloonText.LoadMaskSpans(File.DirAssets,"balloonmask.png",0,180)
		maskR = BalloonText.LoadMaskSpans(File.DirAssets,"balloonmask.png",200,335)
	Catch
		'IDE 里从 Files 加载；直接运行 jar 时从程序目录加载
		maskL = BalloonText.LoadMaskSpans(File.DirApp,"balloonmask.png",0,180)
		maskR = BalloonText.LoadMaskSpans(File.DirApp,"balloonmask.png",200,335)
	End Try
	Dim f As Font = fx.CreateFont("System",15,False,False)
	Dim lineSpacing As Double = f.Size * 0.25
	Dim text As String = "If you encounter any problems, you can contact me by email"
	Dim resultL As Map = BalloonText.WrapInMask(text,f,maskL,lineSpacing,2,1.0,"LEFT")
	Dim resultR As Map = BalloonText.WrapInMask(text,f,maskR,lineSpacing,2,1.0,"RIGHT")
	Log("left success=" & resultL.Get("success"))
	Log(resultL.Get("lines"))
	Log("right success=" & resultR.Get("success"))
	Log(resultR.Get("lines"))

	Dim cw As Int = maskL.Get("width")
	Dim ch As Int = maskL.Get("height")
	Dim maskPane As Pane
	maskPane.Initialize("")

	'用半透明红色画出两个气泡的掩膜轮廓
	Dim cvsNode As JavaObject
	cvsNode.InitializeNewInstance("javafx.scene.canvas.Canvas",Array(cw + 0.0,ch + 0.0))
	Dim gc As JavaObject = cvsNode.RunMethod("getGraphicsContext2D",Null)
	gc.RunMethod("setFill",Array(fx.Colors.ARGB(65,255,0,0)))
	DrawMaskSpans(gc,maskL)
	DrawMaskSpans(gc,maskR)
	Dim cv As Node = cvsNode
	maskPane.AddNode(cv,0,0,cw,ch)

	If resultL.Get("success") Then RenderMaskResult(maskPane,resultL,f,"LEFT")
	If resultR.Get("success") Then RenderMaskResult(maskPane,resultR,f,"RIGHT")

	MainForm.RootPane.AddNode(maskPane,140,120,cw,ch)
End Sub

'按掩膜逐行画出半透明红色轮廓
Sub DrawMaskSpans(gc As JavaObject,mask As Map)
	Dim rowMin As List = mask.Get("rowMin")
	Dim rowMax As List = mask.Get("rowMax")
	Dim h As Int = mask.Get("height")
	For y = 0 To h - 1
		Dim mn As Int = rowMin.Get(y)
		If mn >= 0 Then
			Dim mx As Int = rowMax.Get(y)
			gc.RunMethod("fillRect",Array(mn + 0.0,y + 0.0,(mx-mn+1) + 0.0,1.0))
		End If
	Next
End Sub

'每一行放一个 TextFlow，按掩膜时算出的位置和指定的对齐方式放置
Sub RenderMaskResult(canvas As Pane,result As Map,f As Font,alignment As String)
	Dim lines As List = result.Get("lines")
	Dim centers As List = result.Get("centers")
	Dim slots As List = result.Get("slots")
	Dim top As Double = result.Get("top")
	Dim yMin As Int = result.Get("yMin")
	Dim lineStep As Double = result.Get("lineStep")
	Dim natural As Double = result.Get("naturalLineHeight")
	For i = 0 To lines.Size - 1
		Dim slot As Double = slots.Get(i)
		Dim center As Double = centers.Get(i)
		Dim lf As Pane = BalloonText.CreateLineFlow(lines.Get(i),f,slot,alignment)
		Dim left As Double = center - slot / 2
		Dim topY As Double = yMin + top + i * lineStep
		canvas.AddNode(lf,left,topY,slot,natural)
	Next
End Sub

Sub Button1_Click
	xui.MsgboxAsync("Hello World!", "B4X")
End Sub